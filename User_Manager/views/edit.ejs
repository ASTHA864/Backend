<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  <div class="w-full h-full bg-zinc-900 text-white p-10">
    <div class="nav mb-10">
      <a class="text-blue-500" href="/read">Read Users</a>
    </div>
    <h1 class="text-3xl tracking-tighter mb-3">Update User</h1>
    <form action="/update/<%=user._id%>" method="POST">
      <input class="px-5 py-2 border-2 border-zinc-700 bg-transparent  outline-none rounded-lg" type="text"
        placeholder="name" name="name" value="<%= user.name%>">
      <input class="px-5 py-2 border-2 border-zinc-700 bg-transparent  outline-none rounded-lg" type="text"
        placeholder="email" name="email" value="<%= user.email%>">
      <input class="px-5 py-2 border-2 border-zinc-700 bg-transparent  outline-none rounded-lg" type="text"
        placeholder="image url" name="image" value="<%= user.image%>">
      <input class="px-5 py-2 bg-green-500 rounded-lg ml-3" type="submit" value="Update User">
    </form>
  </div>
</body>

</html>